{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenLang",
  "identifier": "dev.openlang.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    },
    "windows": [
      {
        "label": "caption",
        "url": "caption/index.html",
        "title": "OpenLang subtitles",
        "width": 480,
        "height": 120,
        "minWidth": 240,
        "minHeight": 80,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "skipTaskbar": true,
        "focus": false,
        "focusable": false,
        "acceptFirstMouse": true,
        "visible": false
      },
      {
        "label": "island",
        "url": "island/index.html",
        "title": "OpenLang controls",
        "width": 196,
        "height": 50,
        "resizable": false,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "skipTaskbar": true,
        "focus": false,
        "focusable": false,
        "acceptFirstMouse": true,
        "visible": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Utility",
    "shortDescription": "Live subtitles and translation for any sound",
    "longDescription": "Live subtitles and translation for any sound: films, calls, recordings and the microphone. The free engines run on this computer.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "26.0",
      "signingIdentity": "-",
      "entitlements": "entitlements.plist"
    }
  }
}